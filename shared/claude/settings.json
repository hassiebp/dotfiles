{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title \"✅ Claude Code\" -message \"Task complete! Click to view project.\" -sound default -group \"claude\" -activate \"com.mitchellh.ghostty\" -appIcon \"~/.claude/claude-icon.png\""
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "langfuse-observability@langfuse-observability": true,
    "datadog@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "langfuse-observability": {
      "source": {
        "source": "github",
        "repo": "langfuse/Claude-Observability-Plugin"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754318624322
  },
  "theme": "light"
}
